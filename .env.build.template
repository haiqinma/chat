# Chat 构建 / 发包配置模板
#
# 这个文件只用于静态导出、桌面构建或发包。
# 这里包含两类值：
# 1. 构建工具、版本和签名参数
# 2. 嵌入桌面/静态产物的公开运行默认值
#
# 这里的变量一旦修改，就需要重新构建；桌面端还需要重新发包。
#
# 这些变量不应该作为部署后的日常运行参数去修改。
# 桌面包的出厂服务默认值也由这里提供，并会嵌入静态资源。
# 桌面设置页覆盖能力落地后，用户修改服务地址不需要编辑此文件或重新打包；
# 修改此处的出厂默认值仍然需要重新构建/发包。
#
# 环境来源优先级：命令行/CI 环境变量 > `.env.build` > 代码默认值。
# 构建脚本不会使用 `.env` 作为静态或桌面产物的配置来源。
# Next 构建日志可能仍显示发现了 `.env`，但构建脚本会隔离其中的变量。
#
# 使用方式：
# 1. 复制为 `.env.build`
# 2. 按需修改其中的构建参数
# 3. 执行构建或打包脚本

################################################################################
# 构建期配置
# 生效方式：需要重新构建 / 重新发包
################################################################################

# 说明：
# - `BUILD_MODE`
# - `BUILD_APP`
# 这两个变量不再作为 `.env.build` 的手工配置项。
#
# 它们由构建入口自动决定：
# - `bash scripts/package.sh standalone`
# - `bash scripts/package.sh export`
# - `bash scripts/package.sh app`
# - `bash scripts/package.sh app-release`
# - `npm run export`
# - `npm run app:build`
# - `npm run app:build:release`

# 可选构建版本。正式发包通常由 release tag 或 package.sh 自动注入。
BUILD_VERSION=

# 是否禁用 chunk 拆分：`0` 关闭，`1` 开启。
DISABLE_CHUNK=0

################################################################################
# 桌面包出厂服务默认值
# 生效方式：需要重新构建 / 重新发包；已安装用户的运行时覆盖由 Chat 设置页管理
################################################################################

# 这些都是公开值，会进入静态资源，不能填写 API Key、Token 或私钥。
# 未填写的可选项使用代码默认值。
DEFAULT_INPUT_TEMPLATE=
HIDE_USER_API_KEY=0
ENABLE_BALANCE_QUERY=0
DISABLE_FAST_LINK=0
DEFAULT_MODEL=
SUMMARIZE_MODEL=gpt-5.4-mini
VISION_MODELS=
ENABLE_TOOLS=1

ROUTER_BACKEND_URL=http://localhost:3011
ROUTER_PORTAL_URL=https://router.yeying.pub
ROUTER_PORTAL_TOKEN_URL=
ROUTER_PORTAL_RECHARGE_URL=

WEBDAV_BACKEND_BASE_URL=http://localhost:6065
WEBDAV_BACKEND_PREFIX=/dav

# Node 应用中心 Chat 应用的 applications.uid。
CHAT_APPLICATION_UID=
CENTRAL_UCAN_AUTH_BASE_URL=http://localhost:8100
CENTRAL_UCAN_REDIRECT_URI=chat://localhost/central-ucan-callback.html

MARKETPLACE_SKILL_PACKAGES_URL=
MARKETPLACE_TOOL_PACKAGES_URL=

################################################################################
# 桌面端发包签名配置
# 生效方式：需要重新发包
################################################################################

TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PATH=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
